# Copy this file to .env (and/or ../.env, one directory above this repo) and
# populate it. The real .env is gitignored and lives ONLY on the developer's
# laptop, so secrets can never be committed. Load it with:
#
#   set -a; source .env; set +a
#
# Nothing in this repo's build, test, or CI path reads these values. They are
# needed ONLY to deploy to Base Sepolia and to seed the demo state. No key is
# ever placed on a server (Render) or in CI.

# ---- Deployer (the owner + agent of every contract) ----
# Base Sepolia deployer private key. TESTNET ONLY — fund with gas dust only.
PRIVATE_KEY=
# The address corresponding to PRIVATE_KEY.
ADDRESS=

# ---- Investor A (KYC-verified in the demo; signs the narrative txs) ----
# Investor A private key. TESTNET ONLY.
RWA_INVESTOR_A_PK=
# Investor A address (derived from RWA_INVESTOR_A_PK). Read by the deploy script.
RWA_INVESTOR_A_ADDR=

# ---- Investor B (deliberately NOT whitelisted and NOT funded; keyless) ----
# Only an address is ever known for Investor B — there is no private key. The
# demo's transfer to this address reverts because it is not KYC-verified.
RWA_INVESTOR_B_ADDR=

# ---- Chain + verification ----
# Base Sepolia JSON-RPC endpoint used by forge/cast.
RPC_URL=https://sepolia.base.org
# Node-side RPC override (may differ to dodge throttling); defaults to RPC_URL.
NODE_RPC_URL=https://sepolia.base.org
# Basescan (Etherscan v2) API key, used only for source verification on deploy.
ETHERSCAN_API_KEY=
